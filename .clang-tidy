# STYLE.md's rules, mechanically. See docs/naming.md.
#
# Two checks, and only two. Everything else clang-tidy offers is deliberately off:
# this file exists to make STYLE.md checkable, not to lint.
#
# `readability-identifier-naming` runs everywhere. `misc-include-cleaner` is not
# enabled here at all -- a subsystem turns it on for itself by adding it to the
# `Checks` in its own .clang-tidy, which appends under InheritParentConfig. That is
# what let the tree be swept one subsystem at a time without leaving the rest
# ungated in the meantime, and the set of subsystems carrying that line is the
# record of how far the sweep got.
#
# Headers are opted in per subsystem, never here. A check option is read once per
# translation unit, from the .clang-tidy nearest that TU's .cpp -- so a header
# diagnosed from another subsystem's TU would be judged by that subsystem's rules.
# Each subsystem's .clang-tidy sets HeaderFilterRegex to its own tree, which keeps
# every header judged by the config that sits above it.
Checks: >
  -*,
  readability-identifier-naming

HeaderFilterRegex: ''
FormatStyle: file

CheckOptions:
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.InlineNamespaceCase: lower_case

  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  # The struct half of a std-shaped type trait, whose `_v` variable template is
  # exempted below for the same reason: `is_range_buffer` reads beside
  # `std::is_trivially_copyable`, and only one of the pair may keep the spelling.
  readability-identifier-naming.StructIgnoredRegexp: '^is_[a-z][a-z0-9_]*$'
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase

  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantPrefix: k
  # A constant naming a hardware format keeps the hardware's spelling: RGBA8_UNORM
  # greps against DXGI_FORMAT_R8G8B8A8_UNORM and VK_FORMAT_R8G8B8A8_UNORM, kRgba8Unorm
  # greps against nothing. SCREAMING_CASE is the whole vocabulary of such an enum, its
  # sentinels included -- Format::UNKNOWN and VkFormat::UNDEFINED are spelled the way
  # DXGI_FORMAT_UNKNOWN and VK_FORMAT_UNDEFINED are, not kUnknown beside RGBA8_UNORM.
  readability-identifier-naming.ScopedEnumConstantIgnoredRegexp: '^k?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$'

  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # Catch2 names its registration after the macro, so the declaration clang-tidy sees
  # is spelled TEST_CASE and nobody wrote it.
  readability-identifier-naming.FunctionIgnoredRegexp: '^(TEST_CASE|TEST_CASE_METHOD|TEMPLATE_TEST_CASE|SCENARIO)$'

  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberPrefix: m_
  # A struct is POD and takes no prefix; only classes have m_ members.
  readability-identifier-naming.PublicMemberCase: camelBack

  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack

  readability-identifier-naming.GlobalVariableCase: CamelCase
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.StaticVariableCase: CamelCase
  readability-identifier-naming.StaticVariablePrefix: g_
  # Macro-expanded declarations, reported under the macro's own name: Catch2's
  # registration objects and the Win32 calling-convention macros.
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^(TEST_CASE|TEST_CASE_METHOD|TEMPLATE_TEST_CASE|SCENARIO|APIENTRY|CALLBACK)$'

  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: c_
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: c_
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: c_
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: c_
  # A variable template standing in for a std type trait keeps the std spelling, `_v`
  # and all, so `is_packed_buffer_v` reads beside `std::is_trivially_copyable_v`.
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^([a-z][a-z0-9]*_)+v$|^always_false$'

  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

  # glm is reached through <core/glm.h> and never directly: that header sets
  # GLM_FORCE_DEPTH_ZERO_TO_ONE and friends before glm is parsed, and glm reaching a
  # translation unit unconfigured builds a projection matrix for the wrong depth range.
  # include-cleaner cannot know that. Left to itself it writes <glm/ext.hpp> -- and
  # <glm/detail/qualifier.hpp>, a vendor-internal header -- into any file naming glm::vec3,
  # because `IWYU pragma: export` on core/glm.h only reaches what that header includes
  # directly and not what those pull in transitively. So it is kept out of glm entirely and
  # <core/glm.h> stays the only way in.
  #
  # The pattern is spelled to full-match on purpose, so the identical string works in .clangd:
  # clang-tidy searches, clangd anchors, and `/glm/.*` silences only the first of them. It matches
  # a `glm/` directory, which is vcpkg's layout on every platform; core/glm.h and bgl/glm.h are
  # files rather than directories and are left alone.
  #
  # And the platform C library's own internals. A POSIX symbol has no standard-header mapping
  # -- `sigaction`, `ucontext_t`, `pid_t` are not ISO C -- so include-cleaner falls back to the
  # physical file that declares it, which on Darwin is a split-out internal like
  # <sys/_types/_ucontext.h> or an arch-dispatch header like <mach/arm/kern_return.h>. Neither
  # exists on Windows, and the arch one does not exist on an Intel mac either; <csignal> is what
  # the source already includes and what it should keep. Sweeping from one platform's compile
  # database can only ever name that platform's headers, which is why these are excluded rather
  # than fixed one file at a time.
  misc-include-cleaner.IgnoreHeaders: '.*/glm/.*;.*/sys/_types/.*;.*/sys/signal\.h;.*/mach/(arm|arm64|i386|x86_64)/.*'
