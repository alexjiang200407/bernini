{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); exec \"$PY\" \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/gh_guard.py",
            "statusMessage": "Checking the PR rules"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); exec \"$PY\" \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ask_guard.py",
            "statusMessage": "Checking the ask session is reading"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); exec \"$PY\" \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/draft_commit.py",
            "statusMessage": "Checking for a spec draft"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); exec \"$PY\" \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/pr_watch_guard.py",
            "statusMessage": "Checking for an unwatched PR"
          }
        ]
      }
    ]
  }
}
