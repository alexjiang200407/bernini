#!/usr/bin/env sh
# Format staged C++ and Slang sources with clang-format, then check the staged lines against the
# naming rules, so neither lands wrong. Both scripts locate their tool via scripts/config.json, then
# PATH, then a known LLVM install. Enabled by `git config core.hooksPath .githooks` (set by
# `just init`).
#
# The naming check needs a compile database, which only the Ninja and Makefile generators write; it
# is skipped rather than failed when there isn't one, so a Visual Studio-generator checkout still
# commits. `SKIP_TIDY=1 git commit` skips it outright.

# Staged source files that still exist (Added/Copied/Modified/Renamed).
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' '*.slang')

if command -v python3 >/dev/null 2>&1; then
	py=python3
else
	py=python
fi

if [ -n "$files" ]; then
	# shellcheck disable=SC2086
	"$py" scripts/format.py $files || exit 1

	# Re-stage the (possibly reformatted) files so the formatting is part of this commit.
	# shellcheck disable=SC2086
	printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add
fi

# Staged lines only: an existing violation elsewhere in the file is not the problem of whoever
# happens to edit it next.
if [ -z "$SKIP_TIDY" ]; then
	"$py" scripts/tidy.py --changed --if-configured || exit 1
fi
