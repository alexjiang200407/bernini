# Git LFS settings for this project. See docs/lfs.md.
#
# Only lfs.url belongs here: git-lfs rejects any key it does not recognise as safe in a
# .lfsconfig, warning about it on every command, because this file arrives with a clone.
# The store's location lives in .lfsstore and the agent's keys are machine-local, written
# by `just init`.

[lfs]
	# Never contacted. `just init` sets lfs.standalonetransferagent locally, which makes
	# git-lfs skip the batch API and hand every transfer to the agent; this only has to
	# parse as a URL for it to get that far. Pointing at nothing is deliberate: a clone
	# that has not run `just init` must not silently ask GitHub for objects it does not
	# have.
	url = https://bernini.invalid/lfs

	# A clone has no agent configured yet -- that is machine-local, and `just init` writes
	# it -- so the first checkout cannot fetch anything. Excluding everything makes it not
	# try: the pointers are written and the clone finishes clean. `just init` overrides
	# this in the clone's own config, which outranks a committed .lfsconfig, and pulls.
	# Without it the smudge filter aborts on the first object and leaves the working tree
	# half-written, before init has had any chance to run.
	fetchexclude = *
