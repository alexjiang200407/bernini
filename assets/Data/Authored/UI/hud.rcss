/* A coloured box, a line of text and a target-backed image: the three things the renderer has to
   get across -- vertex colour, the glyph atlas it generates, and a texture it resolves. */
body
{
	width: 100%;
	height: 100%;
	font-family: Lato;
	pointer-events: none;
}

.box
{
	position: absolute;
	left: 16px;
	top: 16px;
	width: 96px;
	height: 64px;
	background-color: #cc3333;
}

.label
{
	position: absolute;
	left: 16px;
	top: 96px;
	font-size: 28px;
	color: #ffffff;
}

.preview
{
	position: absolute;
	left: 144px;
	top: 16px;
	width: 96px;
	height: 96px;
}
