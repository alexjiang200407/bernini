/* Explicit boxes throughout: a case asserts where they landed, and a layout that depended on text
   metrics would assert a font's shaping rather than this engine's layout. */
/* The body covers the frame but takes no clicks: a HUD lets the game have every pixel it did not
   draw a control on, which is what makes ProcessMouseButtonDown's bool worth reading. */
body
{
	width: 100%;
	height: 100%;
	font-family: Lato;
	font-size: 16px;
	color: #ffffff;
	pointer-events: none;
}

.panel
{
	position: absolute;
	left: 32px;
	top: 32px;
	width: 240px;
	height: 120px;
	background-color: #202830;
	pointer-events: auto;
}

.button
{
	position: absolute;
	left: 48px;
	top: 48px;
	width: 120px;
	height: 32px;
	background-color: #3b6ea5;
}

.readout
{
	position: absolute;
	left: 48px;
	top: 96px;
	width: 120px;
	height: 8px;
	background-color: #a53b3b;
}
