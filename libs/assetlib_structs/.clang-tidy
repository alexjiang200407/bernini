# assetlib_structs holds the PODs assetlib decodes into, and holds no function: a question about a
# container is answered in assetlib, which is the library that has the answers. See the root
# CLAUDE.md. What this case setting still governs is selfcheck.cpp's one anchor definition, spelled
# the way assetlib spells a free function so the two never disagree.

InheritParentConfig: true

CheckOptions:
  readability-identifier-naming.FunctionCase: camelBack

# Include hygiene, on for this subsystem. See docs/naming.md; the root config enables it
# nowhere and each subsystem opts itself in as it is swept.
Checks: >
  misc-include-cleaner
