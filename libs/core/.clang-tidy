# core is the vocabulary layer. Its free functions sit beside <algorithm> in a
# call, not beside the engine's, so they are lower_case -- `split_once`, not
# `SplitOnce`. Types are still the engine's PascalCase unless they model a
# standard-library concept, which is what containers/ and str/ hold.
InheritParentConfig: true

CheckOptions:
  readability-identifier-naming.FunctionCase: lower_case
  # core::type_traits stands in for <type_traits>, and a constraint is read beside the
  # trait it wraps -- `trivially_copyable T` next to `std::is_trivially_copyable_v<T>`.
  # Only the snake_case spelling is exempt; a concept named for the engine's own idea of
  # a type, like PackedElementConcept, is still PascalCase.
  readability-identifier-naming.ConceptIgnoredRegexp: '^[a-z][a-z0-9_]*$'

# Include hygiene, on for this subsystem. See docs/naming.md; the root config enables it
# nowhere and each subsystem opts itself in as it is swept.
Checks: >
  misc-include-cleaner
